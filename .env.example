# ── Required ────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# "development" keeps the API open locally when API_KEY is empty.
# Anything else (the default is production) refuses requests until API_KEY is set,
# and refuses to start if the two ALLOW_* switches below are on or Docker is missing.
# On a server: APP_ENV=production and a long random API_KEY.
APP_ENV=development
API_KEY=

# ── Accounts and email ──────────────────────────────────────
# People sign up with email + password. API_KEY / API_KEYS above stay as operator keys.
# Where links in emails point: the public address of this app
PUBLIC_BASE_URL=http://localhost:8000
SIGNUPS_OPEN=true
# Local development without keys stays open; set false to try the logged-in experience
OPEN_DEV_ACCESS=true
# SMTP for verification and password-reset emails. Unset in development: links print to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=CODE_AGENT <no-reply@your-domain.example>

# ── Public live demo (scripted model, real sandbox, no sign-up) ──
DEMO_ENABLED=true
DEMO_RUNS_PER_10_MIN=5
DEMO_CONCURRENCY=2

# ── Plans and payment ───────────────────────────────────────
# The Upgrade button opens this. {user_id} and {email} are filled in for matching payments.
PAYMENT_LINK_URL=
MAINTENANCE_INTERVAL_HOURS=6

# ── Production ──────────────────────────────────────────────
# Your domain, for Caddy (deploy/docker-compose.caddy.yml) and HTTPS
DOMAIN=
# Accounts allowed on the admin page (users, plans, usage, disable switch, backups)
ADMIN_EMAILS=
# Backups of the database and memory, taken safely while running. Copy them off the machine!
BACKUP_DIR=/data/backups
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
# Error tracking (optional). Never sends request bodies, cookies, keys or local variables.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
RELEASE=

# ── Model ───────────────────────────────────────────────────
MODEL=qwen/qwen3.8-27b
# AVAILABLE_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# ── Sandbox ─────────────────────────────────────────────────
SANDBOX_TIMEOUT=10
# SANDBOX_IMAGE=python:3.11-slim
# Never enable on a shared or public server: runs model output directly on the host.
ALLOW_UNSAFE_HOST_SUBPROCESS=false
# Lets /execute run caller-supplied code. Leave off unless you need it.
ALLOW_CODE_OVERRIDE=false

# ── Limits ──────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_SANDBOXES=4

# ── GitHub PR automation (optional) ─────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=FarhanAaqil/self-improving-agent
# GITHUB_ALLOWED_REPOS=owner/another-repo

# ── Workspaces, budgets, sharing ────────────────────────────
# More keys, each an isolated workspace: alice:key1,team-b:key2
API_KEYS=
# Let callers send their own Groq key in X-Groq-Key (used per run, never stored)
ALLOW_BYO_GROQ_KEY=true
# Per-workspace daily token cap for new runs (0 = off)
DAILY_TOKEN_BUDGET=0
# Signs exported verification certificates
CERT_SIGNING_KEY=

# ── Operations ──────────────────────────────────────────────
# "json" for structured logs with request ids
LOG_FORMAT=text
# Scripted offline model for demos and end-to-end tests (real sandbox, no Groq)
FAKE_LLM=false

# ── Verification ────────────────────────────────────────────
# After the tests pass, break the code on purpose and write stricter tests for the gaps
MUTATION_ENABLED=true
# Wait out rate limits instead of failing the run
LLM_MAX_RETRIES=6
LLM_MAX_WAIT_SECONDS=60
