# ── Required ────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# "development" keeps the API open locally when API_KEY is empty.
# Anything else (the default is production) refuses requests until API_KEY is set.
APP_ENV=development
API_KEY=

# ── Model ───────────────────────────────────────────────────
MODEL=qwen/qwen3.8-27b
# AVAILABLE_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# ── Sandbox ─────────────────────────────────────────────────
SANDBOX_TIMEOUT=10
# SANDBOX_IMAGE=python:3.11-slim
# Never enable on a shared or public server: runs model output directly on the host.
ALLOW_UNSAFE_HOST_SUBPROCESS=false
# Lets /execute run caller-supplied code. Leave off unless you need it.
ALLOW_CODE_OVERRIDE=false

# ── Limits ──────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_SANDBOXES=4

# ── GitHub PR automation (optional) ─────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=FarhanAaqil/self-improving-agent
# GITHUB_ALLOWED_REPOS=owner/another-repo

# ── Workspaces, budgets, sharing ────────────────────────────
# More keys, each an isolated workspace: alice:key1,team-b:key2
API_KEYS=
# Let callers send their own Groq key in X-Groq-Key (used per run, never stored)
ALLOW_BYO_GROQ_KEY=true
# Per-workspace daily token cap for new runs (0 = off)
DAILY_TOKEN_BUDGET=0
# Signs exported verification certificates
CERT_SIGNING_KEY=

# ── Operations ──────────────────────────────────────────────
# "json" for structured logs with request ids
LOG_FORMAT=text
# Scripted offline model for demos and end-to-end tests (real sandbox, no Groq)
FAKE_LLM=false

# ── Verification ────────────────────────────────────────────
# After the tests pass, break the code on purpose and write stricter tests for the gaps
MUTATION_ENABLED=true
# Wait out rate limits instead of failing the run
LLM_MAX_RETRIES=6
LLM_MAX_WAIT_SECONDS=60
