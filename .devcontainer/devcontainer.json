{
  "name": "self-improving-agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "postCreateCommand": "pip install -e '.[dev]' && cp -n .env.example .env && npm --prefix frontend ci && docker pull python:3.11-slim",
  "postAttachCommand": "uvicorn app.main:app --reload --port 8000",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API + UI", "onAutoForward": "openPreview" },
    "5173": { "label": "Vite dev server" }
  }
}
