# ── Required ────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# "development" keeps the API open locally when API_KEY is empty.
# Anything else (the default is production) refuses requests until API_KEY is set.
APP_ENV=development
API_KEY=

# ── Model ───────────────────────────────────────────────────
MODEL=qwen/qwen3.8-27b
# AVAILABLE_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# ── Sandbox ─────────────────────────────────────────────────
SANDBOX_TIMEOUT=10
# SANDBOX_IMAGE=python:3.11-slim
# Never enable on a shared or public server: runs model output directly on the host.
ALLOW_UNSAFE_HOST_SUBPROCESS=false
# Lets /execute run caller-supplied code. Leave off unless you need it.
ALLOW_CODE_OVERRIDE=false

# ── Limits ──────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_SANDBOXES=4

# ── GitHub PR automation (optional) ─────────────────────────
GITHUB_TOKEN=
GITHUB_REPO=FarhanAaqil/self-improving-agent
# GITHUB_ALLOWED_REPOS=owner/another-repo
